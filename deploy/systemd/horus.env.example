# /etc/horus/horus.env — read by horus.service (EnvironmentFile=).
# Every value has a default; uncomment what you need to change.

# DNS listener (UDP + TCP). If systemd-resolved runs its stub on 127.0.0.53:53,
# either bind a specific address here (e.g. 10.0.0.53:53) or set
# DNSStubListener=no in /etc/systemd/resolved.conf.
#HORUS_DNS_LISTEN=:53

# REST API.
#   Unix socket for the local CLI ("none" disables it):
#HORUS_API_SOCKET=/run/horus/api.sock
#   TCP listener for the cluster operators (disabled when empty). Use TLS:
#   bearer tokens must not travel in clear text between networks.
#HORUS_API_LISTEN=:8053
#   TLS: install deploy/systemd/horus-tls.conf as a drop-in. It passes
#   /etc/horus/tls/tls.{crt,key} as systemd credentials, which horus picks up
#   automatically (DynamicUser=yes cannot read root-owned files directly).
#   Set these only to override that, e.g. when running outside systemd:
#HORUS_API_TLS_CERT=/etc/horus/tls/tls.crt
#HORUS_API_TLS_KEY=/etc/horus/tls/tls.key

# Storage.
#HORUS_DB=/var/lib/horus/horus.db
#HORUS_BACKUP_DIR=/var/lib/horus/backups

# Upstream resolvers for everything outside our zones, tried in order
# (starting from the last one that answered). Port defaults to 53.
#HORUS_UPSTREAMS=1.1.1.1,9.9.9.9
#HORUS_UPSTREAM_TIMEOUT=2s

# Forwarding cache.
#HORUS_CACHE_MAX_ENTRIES=10000
#HORUS_CACHE_MAX_TTL=1h
#HORUS_CACHE_NEG_TTL=5m

# Synthesized SOA for our zones.
#HORUS_SOA_MNAME=ns.horus.
#HORUS_SOA_RNAME=hostmaster.horus.

# Logging (JSON to journald).
#HORUS_LOG_LEVEL=info
#HORUS_QUERY_LOG=false

# Admin token: by default the systemd credential "admin-token"
# (LoadCredential= in the unit). Set this only when running outside systemd.
#HORUS_ADMIN_TOKEN_FILE=/etc/horus/admin.token
