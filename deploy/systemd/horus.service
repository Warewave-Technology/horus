[Unit]
Description=horus internal DNS server
Documentation=file:///usr/local/share/doc/horus/DESIGN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/horus serve
ExecReload=/bin/kill -HUP $MAINPID
EnvironmentFile=/etc/horus/horus.env

# Admin token as a systemd credential: the file stays root-only, the service
# reads it from $CREDENTIALS_DIRECTORY/admin-token.
LoadCredential=admin-token:/etc/horus/admin.token

# Unprivileged, ephemeral user; /var/lib/horus and /run/horus are created for it.
DynamicUser=yes
StateDirectory=horus
StateDirectoryMode=0700
RuntimeDirectory=horus
RuntimeDirectoryMode=0750

# Port 53 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

Restart=on-failure
RestartSec=2s
WatchdogSec=30s
TimeoutStopSec=10s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
